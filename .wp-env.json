{
	"port": 8890,
	"themes": [
		"./bado-blog"
		"./bado-blog-child"
	],
	"plugins": [
    "./bbPress",
    "./custom-community"
],
	"mappings": {
		"wp-content/plugins/buddyPress": "./buddypress"
	},
	"lifecycleScripts": {
		"afterStart": "wp-env run cli wp theme activate bado-blog && wp-env run cli wp plugin activate buddyPress/bp-loader.php"
	},
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_DISPLAY": false,
		"WP_DEBUG_LOG": true,
		"SCRIPT_DEBUG": true
	},
	"testsEnvironment": false
}


